# =============================================
# SanMaHot - Production Environment Variables
# Copy file này thành .env và điền giá trị thật
# KHÔNG BAO GIỜ commit file .env lên Git!
# =============================================

# --- Database ---
POSTGRES_USER=sanmahot
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=sanmahot_production

# --- Rails ---
SECRET_KEY_BASE=YOUR_SECRET_KEY_BASE_HERE   # Tạo bằng: bundle exec rails secret
RAILS_ENV=production

# --- AccessTrade ---
ACCESSTRADE_API_KEY=YOUR_ACCESSTRADE_API_KEY_HERE

# --- Redis ---
REDIS_URL=redis://redis:6379/1
